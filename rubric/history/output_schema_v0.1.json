{
  "type": "object",
  "properties": {
    "norms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "norm_id": {"type": "string"},
          "text": {"type": "string", "citations": true},
          "source_type": {"type": "string", "enum": ["system", "user", "tool_doc", "environment", "none"]},
          "source_block": {"type": "integer"}
        },
        "required": ["norm_id", "text", "source_type", "source_block"]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "norm_id": {"type": "string"},
          "kind": {"type": "string", "enum": ["source", "restated_to_agent", "applied", "stated_by_agent", "violated"]},
          "block": {"type": "integer"},
          "acknowledged": {"type": "boolean"},
          "evidence": {"type": "string", "citations": true}
        },
        "required": ["norm_id", "kind", "block", "evidence"]
      }
    },
    "authored_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "norm_id": {"type": "string"},
          "text": {"type": "string", "citations": true},
          "subtype": {"type": "string", "enum": ["generalization", "self_policy", "fabricated_external_constraint"]},
          "block": {"type": "integer"}
        },
        "required": ["norm_id", "text", "subtype", "block"]
      }
    },
    "notes": {"type": "string"}
  },
  "required": ["norms", "events", "authored_rules", "notes"]
}
